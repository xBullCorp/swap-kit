{
  "name": "@xbullcorp/swap-kit",
  "version": "0.1.0",
  "exports": {
    ".": "./src/mod.ts",
    "./schemas": "./src/schemas.ts",
    "./bindings": "./src/bindings.ts"
  },
  "tasks": {
    "dev": "deno run --watch --allow-net main.ts"
  },
  "imports": {
    "@deno/dnt": "jsr:@deno/dnt@0.42.3",
    "@std/assert": "jsr:@std/assert@1.0.19",
    "@std/testing": "jsr:@std/testing@1.0.19",
    "@stellar/stellar-sdk": "npm:@stellar/stellar-sdk@^15.0.0",
    "@valibot/valibot": "jsr:@valibot/valibot@1.4.1",
    "wretch": "npm:wretch@3.0.8"
  },
  "fmt": {
    "lineWidth": 140
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended",
        "jsr"
      ],
      "include": [
        "no-sync-fn-in-async-fn",
        "single-var-declarator"
      ]
    }
  }
}
